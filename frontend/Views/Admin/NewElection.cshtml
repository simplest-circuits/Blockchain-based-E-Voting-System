@model NewElectionModel
@{
    ViewData["Title"] = "New Election Wizard";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/typography.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/editor.css" />
    <link rel="stylesheet" href="~/vendor/libs/bs-stepper/bs-stepper.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/moment/moment.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/vendor/libs/select2/select2.js"></script>
    <script src="~/vendor/libs/dropzone/dropzone.js"></script>
    <script src="~/vendor/libs/quill/quill.js"></script>
    <script src="~/vendor/libs/bs-stepper/bs-stepper.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/new-election.css" />
}

@section PageScripts {
    <script src="~/js/pages/new-election.js"></script>
}

<div class="bs-stepper wizard-icons mt-4">
    <div class="bs-stepper-header">
        <div class="step" data-target="#election-details">
            <button type="button" class="step-trigger">
                <span class="bs-stepper-icon">
                    <i class="ti ti-file-description"></i>
                </span>
                <span class="bs-stepper-label">Election Details</span>
            </button>
        </div>
        <div class="line"></div>
        <div class="step" data-target="#time-parameters">
            <button type="button" class="step-trigger">
                <span class="bs-stepper-icon">
                    <i class="ti ti-calendar"></i>
                </span>
                <span class="bs-stepper-label">Time Parameters</span>
            </button>
        </div>
        <div class="line"></div>
        <div class="step" data-target="#security-settings">
            <button type="button" class="step-trigger">
                <span class="bs-stepper-icon">
                    <i class="ti ti-lock"></i>
                </span>
                <span class="bs-stepper-label">Security Settings</span>
            </button>
        </div>
        <div class="line"></div>
        <div class="step" data-target="#candidate-details">
            <button type="button" class="step-trigger">
                <span class="bs-stepper-icon">
                    <i class="ti ti-user"></i>
                </span>
                <span class="bs-stepper-label">Candidate Details</span>
            </button>
        </div>
        <div class="line"></div>
        <div class="step" data-target="#voting-methods">
            <button type="button" class="step-trigger">
                <span class="bs-stepper-icon">
                    <i class="ti ti-checklist"></i>
                </span>
                <span class="bs-stepper-label">Voting Methods</span>
            </button>
        </div>
    </div>
    <div class="bs-stepper-content">
        <form onSubmit="return false">
            <!-- Election Details -->
            <div id="election-details" class="content">
                <div class="content-header mb-4">
                    <h6 class="mb-0">Election Details</h6>
                    <small>Enter the basic details of the election.</small>
                </div>
                <div class="row g-6">
                    <div class="col-sm-6">
                        <label class="form-label" for="electionTitle">Election Title</label>
                        <input type="text" id="electionTitle" class="form-control" placeholder="Enter Election Title" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="electionDescription">Election Description</label>
                        <textarea id="electionDescription" name="ElectionDescription" class="form-control"
                            placeholder="Enter Election Description">@Model.ElectionDescription</textarea>
                    </div>
                    <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-label-secondary btn-prev" disabled> <i
                                class="ti ti-arrow-left ti-xs me-sm-2"></i>
                            <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button class="btn btn-primary btn-next"> <span
                                class="align-middle d-sm-inline-block d-none me-sm-2">Next</span> <i
                                class="ti ti-arrow-right ti-xs"></i></button>
                    </div>
                </div>
            </div>
            <!-- Time Parameters -->
            <div id="time-parameters" class="content">
                <div class="content-header mb-4">
                    <h6 class="mb-0">Time Parameters</h6>
                    <small>Set the timing for the election.</small>
                </div>
                <div class="row g-6">
                    <div class="col-sm-6">
                        <label class="form-label" for="startTimestamp">Start Timestamp</label>
                        <input type="datetime-local" id="startTimestamp" class="form-control" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="endTimestamp">End Timestamp</label>
                        <input type="datetime-local" id="endTimestamp" class="form-control" />
                    </div>
                    <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-label-secondary btn-prev"> <i class="ti ti-arrow-left ti-xs me-sm-2"></i>
                            <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button class="btn btn-primary btn-next"> <span
                                class="align-middle d-sm-inline-block d-none me-sm-2">Next</span> <i
                                class="ti ti-arrow-right ti-xs"></i></button>
                    </div>
                </div>
            </div>
            <!-- Security Settings -->
            <div id="security-settings" class="content">
                <div class="content-header mb-4">
                    <h6 class="mb-0">Security Settings</h6>
                    <small>Configure security settings for the election.</small>
                </div>
                <div class="row g-6">
                    <div class="col-sm-6">
                        <label class="form-label" for="adminAddress">Admin Address</label>
                        <input type="text" id="adminAddress" class="form-control" placeholder="Enter Admin Address" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="encryptionKey">Encryption Key</label>
                        <input type="text" id="encryptionKey" class="form-control" placeholder="Enter Encryption Key" />
                    </div>
                    <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-label-secondary btn-prev"> <i class="ti ti-arrow-left ti-xs me-sm-2"></i>
                            <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button class="btn btn-primary btn-next"> <span
                                class="align-middle d-sm-inline-block d-none me-sm-2">Next</span> <i
                                class="ti ti-arrow-right ti-xs"></i></button>
                    </div>
                </div>
            </div>
            <!-- Candidate Details -->
            <div id="candidate-details" class="content">
                <div class="content-header mb-4">
                    <h6 class="mb-0">Candidate Details</h6>
                    <small>Enter the details of the candidates.</small>
                </div>
                <div class="row g-6">
                    <div class="col-sm-6">
                        <label class="form-label" for="candidateList">Candidate List</label>
                        <input type="text" id="candidateList" class="form-control"
                            placeholder="Enter Candidate Names" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="validElectoralDistricts">Valid Electoral Districts</label>
                        <input type="text" id="validElectoralDistricts" class="form-control"
                            placeholder="Enter Districts" />
                    </div>
                    <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-label-secondary btn-prev"> <i class="ti ti-arrow-left ti-xs me-sm-2"></i>
                            <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button class="btn btn-primary btn-next"> <span
                                class="align-middle d-sm-inline-block d-none me-sm-2">Next</span> <i
                                class="ti ti-arrow-right ti-xs"></i></button>
                    </div>
                </div>
            </div>
            <!-- Voting Methods -->
            <div id="voting-methods" class="content">
                <div class="content-header mb-4">
                    <h6 class="mb-0">Voting Methods</h6>
                    <small>Select the voting methods and parameters.</small>
                </div>
                <div class="row g-6">
                    <div class="col-sm-6">
                        <label class="form-label" for="votingMethod">Voting Method</label>
                        <select id="votingMethod" class="form-control select2">
                            <option value="">Select Method</option>
                            <option value="method1">Method 1</option>
                            <option value="method2">Method 2</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="maxVotesPerUser">Max Votes Per User</label>
                        <input type="number" id="maxVotesPerUser" class="form-control" placeholder="Enter Max Votes" />
                    </div>
                    <div class="col-12 d-flex justify-content-between">
                        <button class="btn btn-label-secondary btn-prev"> <i class="ti ti-arrow-left ti-xs me-sm-2"></i>
                            <span class="align-middle d-sm-inline-block d-none">Previous</span>
                        </button>
                        <button class="btn btn-success btn-submit" data-bs-toggle="modal"
                            data-bs-target="#summaryModal">Submit</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="summaryModal" tabindex="-1" aria-labelledby="summaryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="summaryModalLabel">Summary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Summary content will be dynamically inserted here -->
                <ul id="summaryList" class="list-group">
                    <!-- Example: <li class="list-group-item">Election ID: 12345</li> -->
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="confirmSubmit">Confirm Submit</button>
            </div>
        </div>
    </div>
</div>

<!-- Existing Elections Table -->
<div class="container mt-4">
    <div class="card">
        <div class="card-datatable table-responsive">
            <h3 class="card-header">Existing Elections</h3>
            <table class="datatables-candidates table border-top">
                <thead>
                    <tr>
                        <th>Election ID</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <!-- Add other columns as needed -->
                    </tr>
                </thead>
                <tbody>
                    @foreach (var election in ViewBag.ExistingElections)
                    {
                        <tr>
                            <td>@election.ElectionId</td>
                            <td>@election.ElectionTitle</td>
                            <td>@election.ElectionDescription</td>
                            <td>@election.StartTimestamp.ToString("yyyy-MM-dd")</td>
                            <td>@election.EndTimestamp.ToString("yyyy-MM-dd")</td>
                            <!-- Add other properties as needed -->
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">Election Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="detailsList" class="list-group">
                    <!-- Details will be dynamically inserted here -->
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
